# .env.example
# Environment configuration template for local development.
# Selects the LLM provider and stores placeholder credentials without real secrets.
# Links to: src/core/config.py and src/extraction/extractor.py

APP_ENV=development
API_PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/meeting_db

# Use mock for credential-free tests, or groq/openai/gemini for real extraction.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

RATE_LIMIT_PER_MINUTE=60
