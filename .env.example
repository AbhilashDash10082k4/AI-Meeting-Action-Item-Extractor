# .env.example
# Environment configuration file template.
# Defines application settings, database credentials, API endpoints, and LLM keys.
# Links to: src/core/config.py, src/database/connection.py

APP_ENV=development
API_PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/meeting_db
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
RATE_LIMIT_PER_MINUTE=60
